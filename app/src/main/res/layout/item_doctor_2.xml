<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/colorCard"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:rippleColor="@color/colorSecondary"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <!-- Circular Doctor Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/doctorImage2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/dr_one"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/doctorName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Ben Carter, MD"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/doctorSpeciality2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Neurologist"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/doctorRating2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.8"
                    android:textColor="#FFA500"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_glass_card"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="8dp" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_cyan_circle"
                    android:backgroundTint="#07C060"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="#07C060"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Consult Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/viewProfileButton2"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:text="Consult"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorBackground"
            android:backgroundTint="@color/colorPrimary"
            android:background="@drawable/btn_gradient_cyan" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
