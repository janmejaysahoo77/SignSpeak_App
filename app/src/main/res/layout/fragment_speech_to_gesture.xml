<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131125">

    <!-- Glowing Background Spheres -->
    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="@drawable/bg_glow_ambient_indigo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:translationX="-150dp"
        android:translationY="-100dp" />

    <View
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="@drawable/bg_glow_ambient_cyan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationX="150dp"
        android:translationY="200dp" />

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_glow_ambient_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationX="-80dp" />

    <!-- Padding Container simulating the original 20dp padding -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <!-- 1. Instruction Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1B192E"
            app:strokeColor="#494456"
            app:strokeWidth="1dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speak to Convert"
                    android:textColor="#CDBDFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Press and hold the microphone button below and speak a word or sentence. The app will convert your speech into sign language gestures."
                    android:textColor="#CBC3D9"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Placeholder Section (Initially Visible) -->
        <LinearLayout
            android:id="@+id/layoutPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/cardInstruction"
            app:layout_constraintBottom_toTopOf="@id/speakButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/rounded_adaptive_audio_mic_24"
                app:tint="#CDBDFF"
                android:background="@drawable/bg_glass_card_v2"
                android:padding="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for speech input"
                android:textColor="#E4DFFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold the button and start speaking"
                android:textColor="#CBC3D9"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 3. Listening State UI (Initially Gone) -->
        <LinearLayout
            android:id="@+id/layoutListening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardInstruction"
            app:layout_constraintBottom_toTopOf="@id/speakButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:clipChildren="false">

                <!-- Using original bg_cyan_circle as requested no new logic needed -->
                <View
                    android:id="@+id/pulseCircleOuter"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_cyan_circle"
                    android:alpha="0.2" />

                <View
                    android:id="@+id/pulseCircleInner"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_cyan_circle"
                    android:alpha="0.4" />

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/rounded_adaptive_audio_mic_24"
                    app:tint="#CDBDFF"
                    android:background="@drawable/bg_glass_card_v2"
                    android:padding="12dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvListeningStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening..."
                android:textColor="#CDBDFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginTop="24dp" />
        </LinearLayout>

        <!-- 4. Result Display Section (Initially Gone) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#2A273D"
            app:strokeColor="#494456"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardInstruction"
            app:layout_constraintBottom_toTopOf="@id/speakButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You said"
                    android:textColor="#CBC3D9"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRecognizedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEARCHING..."
                    android:textColor="#CDBDFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="4dp"
                    android:textAlignment="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Showing sign language gesture"
                    android:textColor="#CBC3D9"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1B192E"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/gestureImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Main Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/speakButton"
            android:layout_width="220dp"
            android:layout_height="64dp"
            android:text="Hold to Speak"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:drawableStart="@android:drawable/ic_btn_speak_now"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="#0B1120"
            android:background="@drawable/bg_gradient_btn_primary"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
