<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_device_root">

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ====== HEADER: KINETIC HUD ====== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerVertical="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_kinetic_logo"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvHiddenTrigger"
                    android:text="KINETIC HUD"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF"
                    android:letterSpacing="0.15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_settings_gear"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="2dp"/>
        </RelativeLayout>

        <!-- ====== TITLE: Smart Band ====== -->
        <TextView
            android:text="Smart Band"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="AI-POWERED WEARABLE CONNECTION"
            android:textSize="11sp"
            android:textColor="#667788"
            android:letterSpacing="0.1"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- ====== CONNECTION CARD ====== -->
        <LinearLayout
            android:background="@drawable/bg_device_connection_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Device Name Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bluetooth_connected"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/deviceNameText"
                    android:text="SIGNSPEAK_BAND"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF"
                    android:letterSpacing="0.05"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/statusText"
                    android:text="DISCONNECTED"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FF5252"
                    android:letterSpacing="0.05"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Signal Strength Badge -->
            <TextView
                android:id="@+id/signalStrengthText"
                android:text="SIGNAL STRENGTH: --"
                android:textSize="10sp"
                android:textColor="#667788"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_device_signal_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ====== SCAN & CONNECT BUTTON ====== -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConnect"
            android:text="⚡  SCAN &amp; CONNECT"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_device_scan_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:stateListAnimator="@null"/>

        <!-- ====== ACTION BUTTONS ROW ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:weightSum="2">

            <!-- Test Vibration -->
            <LinearLayout
                android:id="@+id/btnVibrate"
                android:background="@drawable/bg_device_action_btn"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_device_action_circle"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_vibration"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:text="TEST VIBRATION"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA"
                    android:letterSpacing="0.05"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Trigger SOS -->
            <LinearLayout
                android:id="@+id/btnSOS"
                android:background="@drawable/bg_device_action_btn"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_device_action_circle"
                    android:layout_marginBottom="8dp">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_sos"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:text="TRIGGER SOS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#AAAAAA"
                    android:letterSpacing="0.05"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== LIVE TRACKING SECTION ====== -->
        <LinearLayout
            android:background="@drawable/bg_device_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_navigation"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:text="LIVE\nTRACKING"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:lineSpacingExtra="-2sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <!-- Heart Rate Readout -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:text="HR: BPM/S"
                        android:textSize="8sp"
                        android:textColor="#667788"
                        android:letterSpacing="0.05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/latText"
                        android:text="--"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1744"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- SpO2 Readout -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:text="SPO: %AGE"
                        android:textSize="8sp"
                        android:textColor="#667788"
                        android:letterSpacing="0.05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/lonText"
                        android:text="--"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#00E5FF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Live Tracking Indicator -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_device_live_dot"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:text="TRACKING LIVE"
                    android:textSize="9sp"
                    android:textColor="#4ADE80"
                    android:letterSpacing="0.1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Map Area -->
            <FrameLayout
                android:background="@drawable/bg_device_graph_area"
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapView"
                    android:layout_margin="2dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <TextView
                    android:id="@+id/lastMessageText"
                    android:text="Awaiting GPS data..."
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:background="#88000000"
                    android:padding="6dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </LinearLayout>

        <!-- ====== SEND SOS ALERT ====== -->
        <LinearLayout
            android:background="@drawable/bg_device_sos_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_device_sos_circle"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sos"
                    android:layout_gravity="center"/>
            </FrameLayout>

            <TextView
                android:text="SEND SOS ALERT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF1744"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="NOTIFIES EMERGENCY CONTACTS &amp;\nLOCAL AUTHORITIES"
                android:textSize="10sp"
                android:textColor="#667788"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:lineSpacingExtra="2sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ====== DEVICE METRICS SECTION HEADER ====== -->
        <TextView
            android:text="DEVICE METRICS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#667788"
            android:letterSpacing="0.12"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- ====== DEVICE METRICS ROW 1 ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:weightSum="2">

            <!-- Power Cell (Battery) Item -->
            <LinearLayout
                android:background="@drawable/bg_device_metric_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_battery"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="POWER CELL"
                        android:textSize="8sp"
                        android:textColor="#667788"
                        android:letterSpacing="0.08"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="Battery:"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginEnd="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/batteryText"
                            android:text="88%"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#4ADE80"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Signal Latency Item -->
            <LinearLayout
                android:background="@drawable/bg_device_metric_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_signal"
                    android:layout_marginEnd="10dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="SIGNAL LATENCY"
                        android:textSize="8sp"
                        android:textColor="#667788"
                        android:letterSpacing="0.08"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/latencyText"
                        android:text="12ms"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFAB40"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ====== DEVICE METRICS ROW 2 ====== -->
        <LinearLayout
            android:background="@drawable/bg_device_metric_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_uptime"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="UPTIME"
                    android:textSize="8sp"
                    android:textColor="#667788"
                    android:letterSpacing="0.08"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/uptimeText"
                    android:text="14h 22m"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00E5FF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- ====== FULL SCREEN MAP OVERLAY ====== -->
    <RelativeLayout
        android:id="@+id/fullScreenMapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp"
        android:background="#050A12">

        <org.osmdroid.views.MapView
            android:id="@+id/mapViewFullScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Back Button Area -->
        <FrameLayout
            android:id="@+id/btnExitFullScreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_device_action_circle"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back_arrow"
                android:layout_gravity="center"/>
        </FrameLayout>
    </RelativeLayout>
</RelativeLayout>
