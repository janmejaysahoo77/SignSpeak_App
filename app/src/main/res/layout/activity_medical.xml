<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7f9fc"
    tools:context=".MedicalActivity">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/llBottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_medical_bottom_nav"
        android:elevation="16dp"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_medical_bottom_nav_item"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_add"
                android:duplicateParentState="true"
                app:tint="@color/color_medical_bottom_nav_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOCTORS"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:duplicateParentState="true"
                android:textColor="@color/color_medical_bottom_nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabAppointments"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_medical_bottom_nav_item"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:duplicateParentState="true"
                app:tint="@color/color_medical_bottom_nav_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCHEDULE"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:duplicateParentState="true"
                android:textColor="@color/color_medical_bottom_nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPrescription"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_medical_bottom_nav_item"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_edit"
                android:duplicateParentState="true"
                app:tint="@color/color_medical_bottom_nav_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCRIPTS"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:duplicateParentState="true"
                android:textColor="@color/color_medical_bottom_nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabPharmacy"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_medical_bottom_nav_item"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:duplicateParentState="true"
                app:tint="@color/color_medical_bottom_nav_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHARMACY"
                android:textSize="10sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:duplicateParentState="true"
                android:textColor="@color/color_medical_bottom_nav_text" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
