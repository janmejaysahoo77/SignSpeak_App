<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2200E5FF" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#4400E5FF" />
            <size android:width="88dp" android:height="88dp" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#8800E5FF" />
            <solid android:color="#131125" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
</layer-list>
