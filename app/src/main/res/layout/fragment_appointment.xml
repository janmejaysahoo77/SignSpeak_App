<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/consult_a_doctor"
            android:textColor="@color/colorTextPrimary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find trusted specialists instantly"
            android:textColor="@color/colorTextSecondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- Quick Help Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bannerQuickHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/btn_gradient_cyan"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Need help immediately?"
                        android:textColor="@color/colorBackground"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Video Consultation"
                        android:textColor="@color/colorBackground"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/baseline_local_hospital_24"
                    app:tint="@color/colorBackground" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- Search bar -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Search symptoms or doctor"
            android:padding="16dp"
            android:background="@drawable/bg_search_premium"
            android:textColor="@color/colorTextPrimary"
            android:textColorHint="@color/colorTextSecondary"
            android:drawableStart="@drawable/baseline_search_24"
            android:drawableTint="@color/colorTextSecondary"
            android:drawablePadding="12dp"
            android:layout_marginBottom="24dp" />

        <!-- Category Chips ScrollView -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <TextView
                    android:id="@+id/chipGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General"
                    android:textColor="@color/colorBackground"
                    android:background="@drawable/bg_chip_category"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                    
                <TextView
                    android:id="@+id/chipAyurveda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ayurveda"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_chip_category"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                    
                <TextView
                    android:id="@+id/chipNeurology"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neurology"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_chip_category"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                    
                <TextView
                    android:id="@+id/chipCardiology"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiology"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_chip_category"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                    
                <TextView
                    android:id="@+id/chipDentist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dentist"
                    android:textColor="@color/colorTextPrimary"
                    android:background="@drawable/bg_chip_category"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>


        <!-- Top Doctors -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/top_doctors"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Horizontal Doctor Cards Scroller -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <include layout="@layout/item_doctor_horizontal" />
                <include layout="@layout/item_doctor_horizontal" />
                <include layout="@layout/item_doctor_horizontal" />
                
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Nearby Doctors List -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nearby Doctors"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Emergency Card -->
        <LinearLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/rounded_emergency">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/baseline_emergency_24"
                android:layout_gravity="center"/>

            <TextView
                android:text="@string/emergency_call_108"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textColor="#B00020"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btnCallEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/call_now"
                android:backgroundTint="@color/colorError"
                android:textColor="@android:color/white"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
