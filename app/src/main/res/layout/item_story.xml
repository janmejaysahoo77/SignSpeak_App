<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="8dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <androidx.cardview.widget.CardView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            app:cardCornerRadius="30dp"
            app:cardElevation="0dp"
            android:foreground="@drawable/bg_story_ring">
            <ImageView
                android:id="@+id/ivStoryProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder" />
        </androidx.cardview.widget.CardView>

        <!-- Plus badge for "Your Story" -->
        <ImageView
            android:id="@+id/ivAddBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_add_story"
            android:src="@android:drawable/ic_input_add"
            android:scaleType="center"
            app:tint="#d3bcfc"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User"
        android:textColor="#cbc3d9"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="64dp"
        android:gravity="center"
        android:layout_marginTop="4dp" />

</LinearLayout>
